<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <CompileExports Condition=" '$(Configuration)' == 'Release'">false</CompileExports>
        <DefineConstants>$(DefineConstants);RENDER_TEMPLATES</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ourogen.Templates\Ourogen.Templates.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <PrivateAssets>all</PrivateAssets>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    </ItemGroup>

    <Import Project="..\Ourogen.Templates\build\Ourogen.Templates.props" />
    <Import Project="..\Ourogen.Templates\build\Ourogen.Templates.targets" />

</Project>
